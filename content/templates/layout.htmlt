{{define "layout"}}<!DOCTYPE html>
<html>
    <head>
        <title>{{.Title | html}}{{if .TitleSuffix}} {{.TitleSuffix | html}}{{end}}</title>
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <meta name="apple-mobile-web-app-capable" content="yes">
        <meta name="mobile-web-app-capable" content="yes">
        <meta http-equiv="refresh" content="30">
        {{range .Styles}}
            <link rel="stylesheet" href="{{. | html}}"/>
        {{end}}
        {{range .Scripts}}
            <script src="{{. | html}}" defer></script>
        {{end}}
    </head>
    <body class="entity-list">
        <input type="checkbox" id="nav-toggle" class="nav-toggle-checkbox">
        <label for="nav-toggle" class="nav-backdrop"></label>
        <nav class="app-nav">
            <ul>
                {{range .Menu}}
                    <li>
                        {{if .Path}}
                            <a href="{{.Path | html}}"{{if eq .Path $.CurrentPath}} class="current"{{end}}>{{if .Icon}}<i class="bi bi-{{.Icon | html}}"></i> {{end}}{{.Label | html}}</a>
                        {{else}}
                            <span class="nav-group-label">{{.Label | html}}</span>
                        {{end}}
                        {{if .Children}}
                            <ul>
                                {{range .Children}}
                                    <li><a href="{{.Path | html}}"{{if eq .Path $.CurrentPath}} class="current"{{end}}>{{if .Icon}}<i class="bi bi-{{.Icon | html}}"></i> {{end}}{{.Label | html}}</a></li>
                                {{end}}
                            </ul>
                        {{end}}
                    </li>
                {{end}}
            </ul>
        </nav>
        <div class="app-main">
            <div class="page-header">
                <label for="nav-toggle" class="nav-toggle-button" aria-label="Toggle navigation menu"><i class="bi bi-list"></i></label>
                <div class="title">{{.Title | html}}{{if .TitleSuffix}} <span class="title-suffix">{{.TitleSuffix | html}}</span>{{end}}</div>
                {{with .Alerts}}<div class="alert-indicator {{.Class | html}}" title="{{.Description | html}}" role="img" aria-label="{{.Description | html}}"><i class="bi bi-{{.Icon | html}}"></i></div>{{end}}
                <div class="timestamp">{{.CurrentTime.Format "2006-01-02 3:04:05 PM"}}</div>
            </div>
            {{template "content" .}}
        </div>
    </body>
</html>{{end}}
